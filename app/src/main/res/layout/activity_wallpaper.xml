<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/TextAppearance.AeroLauncher.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wallpaper_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wallpaper_none"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/wallpaper_none"
            app:cornerRadius="@dimen/corner_radius" />

        <TextView
            style="@style/TextAppearance.AeroLauncher.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/wallpaper_builtin"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/wallpaper_dusk"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/wallpaper_dusk" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/wallpaper_aurora"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/wallpaper_aurora" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/wallpaper_mist"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/wallpaper_mist" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/wallpaper_ember"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/wallpaper_ember" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wallpaper_photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/wallpaper_photo"
            app:cornerRadius="@dimen/corner_radius" />

        <TextView
            android:id="@+id/wallpaper_blur_label"
            style="@style/TextAppearance.AeroLauncher.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/wallpaper_blur" />

        <SeekBar
            android:id="@+id/wallpaper_blur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="25" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/wallpaper_parallax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/wallpaper_parallax" />

        <TextView
            style="@style/TextAppearance.AeroLauncher.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/wallpaper_parallax_hint" />
    </LinearLayout>
</ScrollView>
