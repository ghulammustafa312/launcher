<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="4dp">

    <ImageView
        android:id="@+id/dock_icon"
        android:layout_width="@dimen/dock_icon_size"
        android:layout_height="@dimen/dock_icon_size"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/dock_remove"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:contentDescription="@string/remove_from_home"
        android:src="@drawable/ic_remove_badge"
        android:visibility="gone" />
</FrameLayout>
