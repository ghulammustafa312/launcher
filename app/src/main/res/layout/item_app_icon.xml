<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/icon_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="@dimen/home_icon_size"
            android:layout_height="@dimen/home_icon_size"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/folder_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_folder"
                android:visibility="gone" />

            <include
                android:id="@+id/folder_mini"
                layout="@layout/folder_mini"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/notification_badge"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-4dp"
                android:background="@drawable/bg_notification_badge"
                android:elevation="2dp"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingHorizontal="4dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/app_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_icon_label_gap"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="@dimen/home_label_text_size" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/remove_badge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:contentDescription="@string/remove_from_home"
        android:padding="1dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_remove_badge"
        android:visibility="gone" />
</FrameLayout>
