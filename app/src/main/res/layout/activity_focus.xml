<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        style="@style/TextAppearance.AeroLauncher.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/focus_title" />

    <RadioGroup
        android:id="@+id/focus_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/focus_off"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/focus_off" />

        <RadioButton
            android:id="@+id/focus_work"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/focus_work" />

        <RadioButton
            android:id="@+id/focus_study"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/focus_study" />

        <RadioButton
            android:id="@+id/focus_sleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/focus_sleep" />
    </RadioGroup>

    <TextView
        android:id="@+id/focus_pick_label"
        style="@style/TextAppearance.AeroLauncher.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/focus_pick_apps"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/focus_app_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
