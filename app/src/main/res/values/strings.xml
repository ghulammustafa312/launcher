    <string name="lock_accessibility_label">Aero Launcher screen lock</string>
    <string name="lock_accessibility_description">Aero Launcher uses this service only to lock the screen when you double-tap the home screen. It does not read your screen content, notifications, or passwords. You can turn it off anytime in system Accessibility settings.</string>
    <string name="lock_opt_in_title">Double-tap to lock</string>
    <string name="lock_opt_in_body">Android only lets apps lock the screen through an AccessibilityService. Aero Launcher will use that service for one action: lock the screen when you double-tap Home.\n\nIt will not read what is on your screen, monitor other apps, or collect personal data.</string>
    <string name="lock_opt_in_privacy">You stay in control: enable the service only if you want this gesture, and disable it whenever you like.</string>
    <string name="lock_opt_in_enable">Continue to Accessibility settings</string>
