<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <!-- Discover launchable apps and widgets without QUERY_ALL_PACKAGES -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:name=".AeroLauncherApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AeroLauncher">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AeroLauncher.Splash"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.AeroLauncher" />

        <activity
            android:name=".LockOptInActivity"
            android:exported="false"
            android:label="@string/lock_opt_in_title"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.AeroLauncher" />

        <activity
            android:name=".WallpaperActivity"
            android:exported="false"
            android:label="@string/wallpaper_title"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.AeroLauncher" />

        <activity
            android:name=".HiddenAppsActivity"
            android:exported="false"
            android:label="@string/hidden_apps_title"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.AeroLauncher" />

        <activity
            android:name=".FocusModeActivity"
            android:exported="false"
            android:label="@string/focus_title"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.AeroLauncher" />

        <activity
            android:name=".BadgeOptInActivity"
            android:exported="false"
            android:label="@string/badge_opt_in_title"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.AeroLauncher" />

        <activity
            android:name=".widgets.builtin.NotesWidgetConfigureActivity"
            android:exported="false"
            android:label="@string/widget_notes_configure_title"
            android:theme="@style/Theme.AeroLauncher" />

        <!-- Opt-in only: used for double-tap lock. No screen content is read. -->
        <service
            android:name=".LockAccessibilityService"
            android:exported="false"
            android:label="@string/lock_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_accessibility_service" />
        </service>

        <!-- Opt-in only: package counts for badges. Never stores notification content. -->
        <service
            android:name=".badges.AeroNotificationListener"
            android:exported="true"
            android:label="@string/badge_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing|silent" />
        </service>

        <receiver
            android:name=".widgets.builtin.ClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <receiver
            android:name=".widgets.builtin.BatteryWidgetProvider"
            android:exported="true"
            android:label="@string/widget_battery_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_info" />
        </receiver>

        <receiver
            android:name=".widgets.builtin.NotesWidgetProvider"
            android:exported="true"
            android:label="@string/widget_notes_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_notes_info" />
        </receiver>

        <receiver
            android:name=".widgets.builtin.WeatherWidgetProvider"
            android:exported="true"
            android:label="@string/widget_weather_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_info" />
        </receiver>

        <receiver
            android:name=".widgets.builtin.CalendarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_calendar_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>
    </application>
</manifest>
